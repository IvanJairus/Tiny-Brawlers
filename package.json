{
  "name": "tiny-brawlers",
  "private": true,
  "version": "2.0.0",
  "description": "Tiny Brawlers: arcade 3D crate-stacking battle arena (homage to Team Buddies)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:speed": "TB_SPEED_GATE=1 vitest run tests/sim/determinism.test.ts",
    "lint:layers": "vitest run tests/layers.test.ts",
    "test:browser": "playwright test --project=desktop --project=phone-landscape --project=phone-portrait --project=production",
    "test:visual": "playwright test --project=visual --project=visual-phone",
    "visual:baseline": "playwright test --project=visual --project=visual-phone --update-snapshots",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "signal": "node scripts/signaling-server.mjs",
    "signal:test": "node scripts/signaling-server.mjs --port 8090"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.160.0",
    "happy-dom": "^21.0.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
